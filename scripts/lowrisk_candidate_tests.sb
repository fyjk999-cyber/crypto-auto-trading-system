(version 1)
(allow default)
; Tests may use synthetic fixture databases only. Never read trading state/lakes.
(deny file-read* (subpath "/Users/huhongjie/Library/Application Support/LowRisk"))
(deny file-read* (subpath "/Users/huhongjie/Library/Application Support/SharedMarketHistory"))
(deny file-read* (subpath "/Users/huhongjie/turbo-deepseek-strategy"))
(deny file-read* (subpath "/Volumes"))
(deny file-write*)
(allow file-write* (subpath "/Users/huhongjie/lowrisk-post-migration-ready"))
(allow file-write* (subpath "/private/tmp"))
(allow file-write* (subpath "/tmp"))
(allow file-write* (literal "/dev/null"))
(deny process-exec (literal "/usr/bin/security"))
(deny process-exec (literal "/bin/launchctl"))
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*"))
