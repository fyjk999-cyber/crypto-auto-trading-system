# Crypto Automated Trading System - example environment (placeholders only)
APP_ENV=development
TRADING_MODE=PAPER        # PAPER | LIVE | SHADOW
LIVE_TRADING_ENABLED=false
DATABASE_URL=sqlite+aiosqlite:///./data/crypto_trader.db
# PostgreSQL example: postgresql+asyncpg://user:pass@localhost:5432/crypto_trader

# Binance (testnet only for harness; NEVER commit real keys)
BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_WS_BASE_URL=wss://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Runtime
RUN_LEASE_TTL_SECONDS=10
RUN_LEASE_RENEW_INTERVAL_SECONDS=3
ENGINE_TICK_SECONDS=0.5
RECONCILIATION_INTERVAL_SECONDS=30
MARKET_DATA_MAX_AGE_SECONDS=5.0
ORDERBOOK_MAX_AGE_SECONDS=2.0

# Observability
LOG_LEVEL=INFO
STRUCTURED_LOGS=true

# Auth (optional; when AUTH_ENABLED=true dangerous endpoints require bearer tokens)
AUTH_ENABLED=false
VIEWER_API_KEY=
OPERATOR_API_KEY=
ADMIN_API_KEY=

# Market data / deployment
APP_ENV=LOCAL
MARKET_DATA_MODE=REAL_MARKET
LIVE_TRADING_ENABLED=false
SHADOW_MODE=FORWARD
BACKUP_PATH=./data/backups
FRONTEND_API_BASE_URL=http://127.0.0.1:8000

# LLM (NOT configured in this milestone)
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Optional: JSON DoH endpoint for LLM provider DNS (empty = disabled)
LLM_DOH_RESOLVER=
