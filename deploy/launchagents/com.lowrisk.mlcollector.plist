<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lowrisk.mlcollector</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/scripts/run_ml_collector_macos.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__REPO__/data/ml/logs/mlcollector.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/ml/logs/mlcollector.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ML_PYTHON</key>
    <string>__PYTHON__</string>
    <key>RUNNING_SHA</key>
    <string>__SHA__</string>
  </dict>
</dict>
</plist>
