<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lowrisk.news</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__REPO__/scripts/run_news_macos.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__REPO__/data/news/logs/news.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/news/logs/news.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ML_PYTHON</key>
    <string>__PYTHON__</string>
    <key>RUNNING_SHA</key>
    <string>__SHA__</string>
    <key>NEWS_ENABLED</key>
    <string>1</string>
    <key>NEWS_DIR</key>
    <string>__REPO__/data/news</string>
    <key>NEWS_DATABASE_URL</key>
    <string>sqlite+aiosqlite:///__REPO__/data/news/news.db</string>
    <key>NEWS_POLL_INTERVAL_SECONDS</key>
    <string>180</string>
  </dict>
</dict>
</plist>
