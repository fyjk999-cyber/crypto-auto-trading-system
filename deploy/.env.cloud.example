# ============================================================
# .env.cloud.example — SERVER-ONLY template (never commit .env.cloud)
# Copy to repository root as .env.cloud on the server and fill secrets.
# ONE APP_ENV value only (repository .env.example duplicates are dev-local).
# ============================================================

APP_ENV=production

# ---- ABSOLUTE SAFETY CONTRACT ----
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
REAL_MONEY_ENABLED=false
PAPER_MODE=PAPER_REAL_MARKET

# ---- 24x7 runtime ----
AUTO_START_RUNTIME=true
SCANNER_ENABLED=true
OPPORTUNITY_SCANNER_ENABLED=true
PAPER_EXPLORATION_MODE=true

# ---- Database (DATABASE_URL itself is injected by docker-compose) ----
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Public entry ----
DOMAIN=trading.example.com
ACME_EMAIL=you@example.com

# ---- Observability ----
STRUCTURED_LOGS=true
LOG_LEVEL=INFO

# ---- LLM encrypted SecretStore (mounted from ../server-data/llm) ----
LLM_SECRET_STORE_PATH=/app/secrets/.llm-secrets.json
LLM_MASTER_KEY_PATH=/app/secrets/.llm-master-key

# ---- Timezone ----
TZ=UTC

# NOTES:
# - MARKET_DATA_MODE is NOT a repository Settings field; real public OKX
#   market data is the canonical behavior of PAPER_MODE=PAPER_REAL_MARKET.
# - Keep the repository-truth trading universe; do not invent symbols.
# - Exploration policy (fit/confidence/sizing/leverage) loads from Settings
#   truth. Do NOT retune because hosting changed.
