<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.crypto-trader.okx-broker</string>
<key>UserName</key><string>crypto-okx-broker</string>
<key>ProgramArguments</key><array>
<string>/Library/Application Support/CryptoOKXBroker/runtime/bin/python3</string>
<string>-I</string><string>-m</string><string>crypto_trader.okx_vault.service</string>
